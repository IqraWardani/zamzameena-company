generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The SQL migration remains authoritative; do not generate or apply Prisma
// migrations from this intentionally partial application client schema.

enum AdminAccountStatus {
  active
  inactive
  suspended

  @@map("admin_account_status")
}

enum EventStatus {
  draft
  published
  closed
  cancelled
  archived

  @@map("event_status")
}

enum RegistrationStatus {
  pending_payment
  payment_submitted
  payment_rejected
  confirmed
  cancelled
  expired

  @@map("registration_status")
}

enum InvoiceStatus {
  pending
  payment_submitted
  paid
  rejected
  void
  expired

  @@map("invoice_status")
}

enum PaymentStatus {
  submitted
  approved
  rejected

  @@map("payment_status")
}

enum DocumentOwnerType {
  payment
  participant
  registration

  @@map("document_owner_type")
}

enum DocumentKind {
  payment_proof
  identity_document
  other

  @@map("document_kind")
}

enum TicketStatus {
  active
  void
  cancelled

  @@map("ticket_status")
}

enum InvitationCollectionMethod {
  invitation_code
  participant_search

  @@map("invitation_collection_method")
}

enum ContactStatus {
  new
  in_progress
  resolved
  spam

  @@map("contact_status")
}

enum NotificationStatus {
  queued
  sent
  failed

  @@map("notification_status")
}

enum SalesMemberPosition {
  director
  arm
  branch_manager
  sales

  @@map("sales_member_position")
}

enum SalesMemberStatus {
  active
  inactive

  @@map("sales_member_status")
}

enum SalesCommissionEntryType {
  earned
  adjustment

  @@map("sales_commission_entry_type")
}

model AdminUser {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                      String                 @unique(map: "admin_users_email_unique") @db.VarChar(320)
  fullName                   String                 @map("full_name") @db.VarChar(160)
  passwordHash               String                 @map("password_hash")
  status                     AdminAccountStatus     @default(active)
  lastLoginAt                DateTime?              @map("last_login_at") @db.Timestamptz(6)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles                  AdminUserRole[]
  assignedUserRoles          AdminUserRole[]        @relation("AssignedBy")
  eventAssignments           EventStaffAssignment[]
  assignedEventStaff         EventStaffAssignment[] @relation("EventStaffAssignedBy")
  createdEvents              Event[]                @relation("EventCreator")
  reviewedPayments           Payment[]              @relation("PaymentReviewer")
  collectedInvitations       InvitationCollection[]
  checkedIns                 CheckIn[]
  assignedContactSubmissions ContactSubmission[]    @relation("ContactAssignedTo")
  auditLogs                  AuditLog[]             @relation("AuditActor")
  uploadedKeyVisuals         EventKeyVisual[]       @relation("KeyVisualUploader")
  createdSalesCommissions    SalesCommission[]      @relation("SalesCommissionCreator")

  @@map("admin_users")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique(map: "roles_code_unique") @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles   AdminUserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique(map: "permissions_code_unique") @db.VarChar(120)
  name        String           @db.VarChar(160)
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model AdminUserRole {
  adminUserId           String     @map("admin_user_id") @db.Uuid
  roleId                String     @map("role_id") @db.Uuid
  assignedByAdminUserId String?    @map("assigned_by_admin_user_id") @db.Uuid
  assignedAt            DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(6)
  adminUser             AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  role                  Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy            AdminUser? @relation("AssignedBy", fields: [assignedByAdminUserId], references: [id], onDelete: SetNull)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Event {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String                  @unique(map: "events_slug_unique") @db.VarChar(160)
  eventCode              String?                 @unique(map: "events_event_code_unique") @map("event_code") @db.VarChar(12)
  name                   String                  @db.VarChar(200)
  description            String?
  startsAt               DateTime                @map("starts_at") @db.Timestamptz(6)
  endsAt                 DateTime                @map("ends_at") @db.Timestamptz(6)
  timezone               String                  @default("Asia/Makassar") @db.VarChar(64)
  venueName              String?                 @map("venue_name") @db.VarChar(200)
  venueAddress           String?                 @map("venue_address")
  status                 EventStatus             @default(draft)
  registrationOpensAt    DateTime?               @map("registration_opens_at") @db.Timestamptz(6)
  registrationClosesAt   DateTime?               @map("registration_closes_at") @db.Timestamptz(6)
  createdByAdminUserId   String?                 @map("created_by_admin_user_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              AdminUser?              @relation("EventCreator", fields: [createdByAdminUserId], references: [id], onDelete: SetNull)
  eventAssignments       EventStaffAssignment[]
  keyVisuals             EventKeyVisual[]
  ticketTypes            TicketType[]
  registrations          Registration[]
  salesMembers           SalesMember[]
  salesReferralSequences SalesReferralSequence[]
  salesReferralCodes     SalesReferralCode[]
  invitationCodes        InvitationCode[]
  invitationCollections  InvitationCollection[]
  checkIns               CheckIn[]

  @@index([status, startsAt], map: "events_status_starts_at_idx")
  @@map("events")
}

model EventStaffAssignment {
  eventId               String     @map("event_id") @db.Uuid
  adminUserId           String     @map("admin_user_id") @db.Uuid
  assignedByAdminUserId String?    @map("assigned_by_admin_user_id") @db.Uuid
  assignedAt            DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(6)
  event                 Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  adminUser             AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  assignedBy            AdminUser? @relation("EventStaffAssignedBy", fields: [assignedByAdminUserId], references: [id], onDelete: SetNull)

  @@id([eventId, adminUserId])
  @@map("event_staff_assignments")
}

model EventKeyVisual {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId               String     @map("event_id") @db.Uuid
  uploadedByAdminUserId String?    @map("uploaded_by_admin_user_id") @db.Uuid
  originalFilename      String     @map("original_filename") @db.VarChar(255)
  contentType           String     @map("content_type") @db.VarChar(127)
  byteSize              BigInt     @map("byte_size")
  objectKey             String     @unique(map: "event_key_visuals_object_key_unique") @map("object_key")
  url                   String     @db.VarChar(500)
  isActive              Boolean    @default(false) @map("is_active")
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt             DateTime?  @map("deleted_at") @db.Timestamptz(6)
  event                 Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  uploadedBy            AdminUser? @relation("KeyVisualUploader", fields: [uploadedByAdminUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt], map: "event_key_visuals_event_created_idx")
  @@map("event_key_visuals")
}

model TicketType {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  code          String         @db.VarChar(80)
  name          String         @db.VarChar(160)
  description   String?
  priceAmount   Decimal        @default(0) @map("price_amount") @db.Decimal(14, 2)
  currency      String         @default("IDR") @db.Char(3)
  capacity      Int?
  salesOpensAt  DateTime?      @map("sales_opens_at") @db.Timestamptz(6)
  salesClosesAt DateTime?      @map("sales_closes_at") @db.Timestamptz(6)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registrations Registration[]

  @@unique([eventId, code], map: "ticket_types_event_code_unique")
  @@index([eventId, isActive], map: "ticket_types_event_active_idx")
  @@map("ticket_types")
}

model Registration {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationNumber     String                 @unique(map: "registrations_number_unique") @map("registration_number") @db.VarChar(40)
  eventId                String                 @map("event_id") @db.Uuid
  participantProfileId   String                 @map("participant_profile_id") @db.Uuid
  ticketTypeId           String                 @map("ticket_type_id") @db.Uuid
  sellerMemberId         String?                @map("seller_member_id") @db.Uuid
  referralCodeSnapshot   String?                @map("referral_code_snapshot") @db.VarChar(40)
  status                 RegistrationStatus     @default(pending_payment)
  registeredAt           DateTime               @default(now()) @map("registered_at") @db.Timestamptz(6)
  confirmedAt            DateTime?              @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt            DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason     String?                @map("cancellation_reason")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  event                  Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participantProfile     ParticipantProfile     @relation(fields: [participantProfileId], references: [id], onDelete: Restrict)
  ticketType             TicketType             @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  salesMember            SalesMember?           @relation(fields: [sellerMemberId, eventId], references: [id, eventId], onDelete: Restrict)
  answers                RegistrationAnswer[]
  invoices               Invoice[]
  tickets                Ticket[]
  invitationCodes        InvitationCode[]
  invitationCollection   InvitationCollection?
  checkIn                CheckIn?
  notificationDeliveries NotificationDelivery[]
  salesCommissions       SalesCommission[]

  @@unique([eventId, participantProfileId], map: "registrations_participant_event_unique")
  @@index([eventId, status], map: "registrations_event_status_idx")
  @@index([participantProfileId], map: "registrations_participant_idx")
  @@index([sellerMemberId, registeredAt], map: "registrations_seller_member_idx")
  @@map("registrations")
}

model ParticipantProfile {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName               String                 @map("full_name") @db.VarChar(160)
  email                  String                 @db.VarChar(320)
  phone                  String                 @db.VarChar(40)
  organizationName       String?                @map("organization_name") @db.VarChar(200)
  jobTitle               String?                @map("job_title") @db.VarChar(160)
  city                   String?                @db.VarChar(120)
  countryCode            String?                @map("country_code") @db.Char(2)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  registrations          Registration[]
  notificationDeliveries NotificationDelivery[]
  consents               ParticipantConsent[]

  @@index([email], map: "participant_profiles_email_idx")
  @@map("participant_profiles")
}

model RegistrationAnswer {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId String       @map("registration_id") @db.Uuid
  fieldKey       String       @map("field_key") @db.VarChar(100)
  answer         Json         @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@unique([registrationId, fieldKey], map: "registration_answers_field_unique")
  @@map("registration_answers")
}

model Invoice {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber       String            @unique(map: "invoices_number_unique") @map("invoice_number") @db.VarChar(40)
  legacyInvoiceNumber String?           @unique(map: "invoices_legacy_number_unique") @map("legacy_invoice_number") @db.VarChar(40)
  registrationId      String            @map("registration_id") @db.Uuid
  currency            String            @default("IDR") @db.Char(3)
  amountDue           Decimal           @map("amount_due") @db.Decimal(14, 2)
  unitPriceAmount     Decimal?          @map("unit_price_amount") @db.Decimal(14, 2)
  quantity            Int?
  subtotalAmount      Decimal?          @map("subtotal_amount") @db.Decimal(14, 2)
  discountAmount      Decimal?          @map("discount_amount") @db.Decimal(14, 2)
  status              InvoiceStatus     @default(pending)
  dueAt               DateTime?         @map("due_at") @db.Timestamptz(6)
  issuedAt            DateTime          @default(now()) @map("issued_at") @db.Timestamptz(6)
  paidAt              DateTime?         @map("paid_at") @db.Timestamptz(6)
  voidedAt            DateTime?         @map("voided_at") @db.Timestamptz(6)
  voidReason          String?           @map("void_reason")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  registration        Registration      @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  payments            Payment[]
  salesCommissions    SalesCommission[]

  @@index([registrationId, status], map: "invoices_registration_status_idx")
  @@map("invoices")
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId             String        @map("invoice_id") @db.Uuid
  amountPaid            Decimal       @map("amount_paid") @db.Decimal(14, 2)
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz(6)
  senderName            String?       @map("sender_name") @db.VarChar(160)
  senderBank            String?       @map("sender_bank") @db.VarChar(120)
  referenceNumber       String?       @map("reference_number") @db.VarChar(120)
  status                PaymentStatus @default(submitted)
  submittedAt           DateTime      @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedByAdminUserId String?       @map("reviewed_by_admin_user_id") @db.Uuid
  reviewedAt            DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNote            String?       @map("review_note")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  invoice               Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reviewedBy            AdminUser?    @relation("PaymentReviewer", fields: [reviewedByAdminUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId, status], map: "payments_invoice_status_idx")
  @@map("payments")
}

model SalesMember {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String              @map("event_id") @db.Uuid
  personId           String              @map("person_id") @db.Uuid
  supervisorMemberId String?             @map("supervisor_member_id") @db.Uuid
  position           SalesMemberPosition
  fullName           String              @map("full_name") @db.VarChar(160)
  memberCode         String              @map("member_code") @db.VarChar(40)
  phone              String              @db.VarChar(40)
  email              String?             @db.VarChar(320)
  region             String              @db.VarChar(160)
  status             SalesMemberStatus   @default(active)
  joinedAt           DateTime            @default(dbgenerated("CURRENT_DATE")) @map("joined_at") @db.Date
  referralCode       String              @map("referral_code") @db.VarChar(40)
  quotaAmount        Decimal             @default(0) @map("quota_amount") @db.Decimal(14, 2)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  event              Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  person             SalesPerson         @relation(fields: [personId], references: [id], onDelete: Restrict)
  supervisor         SalesMember?        @relation("SalesHierarchy", fields: [supervisorMemberId, eventId], references: [id, eventId], onDelete: Restrict)
  subordinates       SalesMember[]       @relation("SalesHierarchy")
  registrations      Registration[]
  commissions        SalesCommission[]
  referralCodeRecord SalesReferralCode?

  @@unique([id, eventId], map: "sales_members_id_event_unique")
  @@unique([personId, eventId], map: "sales_members_person_event_unique")
  @@index([eventId, position, status], map: "sales_members_event_position_status_idx")
  @@index([supervisorMemberId, status], map: "sales_members_supervisor_status_idx")
  @@map("sales_members")
}

model SalesPerson {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName    String        @map("full_name") @db.VarChar(160)
  memberCode  String        @unique(map: "sales_persons_member_code_unique") @map("member_code") @db.VarChar(40)
  phone       String        @db.VarChar(40)
  email       String?       @db.VarChar(320)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  memberships SalesMember[]

  @@map("sales_persons")
}

model SalesReferralSequence {
  eventId   String              @map("event_id") @db.Uuid
  position  SalesMemberPosition
  lastValue Int                 @default(0) @map("last_value")
  event     Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([eventId, position])
  @@map("sales_referral_sequences")
}

model SalesReferralCode {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String              @map("event_id") @db.Uuid
  salesMemberId  String?             @unique(map: "sales_referral_codes_member_unique") @map("sales_member_id") @db.Uuid
  position       SalesMemberPosition
  sequenceNumber Int?                @map("sequence_number")
  referralCode   String              @map("referral_code") @db.VarChar(40)
  allocatedAt    DateTime            @default(now()) @map("allocated_at") @db.Timestamptz(6)
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  salesMember    SalesMember?        @relation(fields: [salesMemberId], references: [id], onDelete: SetNull)

  @@map("sales_referral_codes")
}

model SalesCommission {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesMemberId        String                   @map("sales_member_id") @db.Uuid
  registrationId       String                   @map("registration_id") @db.Uuid
  invoiceId            String?                  @map("invoice_id") @db.Uuid
  entryType            SalesCommissionEntryType @map("entry_type")
  amount               Decimal                  @db.Decimal(14, 2)
  currency             String                   @db.Char(3)
  idempotencyKey       String                   @unique(map: "sales_commissions_idempotency_unique") @map("idempotency_key") @db.VarChar(160)
  note                 String?                  @db.VarChar(1000)
  createdByAdminUserId String?                  @map("created_by_admin_user_id") @db.Uuid
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  salesMember          SalesMember              @relation(fields: [salesMemberId], references: [id], onDelete: Restrict)
  registration         Registration             @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  invoice              Invoice?                 @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy            AdminUser?               @relation("SalesCommissionCreator", fields: [createdByAdminUserId], references: [id], onDelete: SetNull)

  @@index([salesMemberId, createdAt(sort: Desc)], map: "sales_commissions_member_created_idx")
  @@index([registrationId, entryType], map: "sales_commissions_registration_idx")
  @@map("sales_commissions")
}

model PrivateDocument {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType             DocumentOwnerType @map("owner_type")
  ownerId               String            @map("owner_id") @db.Uuid
  kind                  DocumentKind
  storageProvider       String            @map("storage_provider") @db.VarChar(50)
  objectKey             String            @map("object_key")
  originalFilename      String            @map("original_filename") @db.VarChar(255)
  contentType           String            @map("content_type") @db.VarChar(127)
  byteSize              BigInt            @map("byte_size")
  checksumSha256        String?           @map("checksum_sha256") @db.Char(64)
  uploadedByAdminUserId String?           @map("uploaded_by_admin_user_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt             DateTime?         @map("deleted_at") @db.Timestamptz(6)

  @@unique([storageProvider, objectKey], map: "private_documents_object_unique")
  @@index([ownerType, ownerId], map: "private_documents_owner_idx")
  @@map("private_documents")
}

model Ticket {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketCode      String           @unique(map: "tickets_code_unique") @map("ticket_code") @db.VarChar(80)
  registrationId  String           @unique(map: "tickets_registration_unique") @map("registration_id") @db.Uuid
  status          TicketStatus     @default(active)
  issuedAt        DateTime         @default(now()) @map("issued_at") @db.Timestamptz(6)
  voidedAt        DateTime?        @map("voided_at") @db.Timestamptz(6)
  voidReason      String?          @map("void_reason")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  registration    Registration     @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  invitationCodes InvitationCode[]
  checkIns        CheckIn[]

  @@map("tickets")
}

model InvitationCode {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String                 @map("event_id") @db.Uuid
  code           String                 @db.VarChar(80)
  registrationId String?                @map("registration_id") @db.Uuid
  ticketId       String?                @map("ticket_id") @db.Uuid
  expiresAt      DateTime?              @map("expires_at") @db.Timestamptz(6)
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  event          Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration   Registration?          @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  ticket         Ticket?                @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  collections    InvitationCollection[]

  @@unique([eventId, code], map: "invitation_codes_event_code_unique")
  @@map("invitation_codes")
}

model InvitationCollection {
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                String                     @map("event_id") @db.Uuid
  registrationId         String                     @unique(map: "invitation_collections_registration_unique") @map("registration_id") @db.Uuid
  invitationCodeId       String?                    @map("invitation_code_id") @db.Uuid
  method                 InvitationCollectionMethod
  collectedByAdminUserId String                     @map("collected_by_admin_user_id") @db.Uuid
  collectedAt            DateTime                   @default(now()) @map("collected_at") @db.Timestamptz(6)
  note                   String?
  event                  Event                      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration           Registration               @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  invitationCode         InvitationCode?            @relation(fields: [invitationCodeId], references: [id], onDelete: Restrict)
  collectedBy            AdminUser                  @relation(fields: [collectedByAdminUserId], references: [id], onDelete: Restrict)

  @@map("invitation_collections")
}

model CheckIn {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                String       @map("event_id") @db.Uuid
  registrationId         String       @unique(map: "check_ins_registration_unique") @map("registration_id") @db.Uuid
  ticketId               String?      @map("ticket_id") @db.Uuid
  checkedInByAdminUserId String       @map("checked_in_by_admin_user_id") @db.Uuid
  checkedInAt            DateTime     @default(now()) @map("checked_in_at") @db.Timestamptz(6)
  note                   String?
  event                  Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration           Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  ticket                 Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  checkedInBy            AdminUser    @relation(fields: [checkedInByAdminUserId], references: [id], onDelete: Restrict)

  @@index([eventId, checkedInAt], map: "check_ins_event_checked_idx")
  @@map("check_ins")
}

model AuditLog {
  id               BigInt     @id @default(autoincrement())
  actorAdminUserId String?    @map("actor_admin_user_id") @db.Uuid
  eventId          String?    @map("event_id") @db.Uuid
  action           String     @db.VarChar(120)
  entityType       String     @map("entity_type") @db.VarChar(80)
  entityId         String?    @map("entity_id") @db.Uuid
  metadata         Json       @default("{}") @db.JsonB
  userAgent        String?    @map("user_agent")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  actor            AdminUser? @relation("AuditActor", fields: [actorAdminUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ContactSubmission {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String        @db.VarChar(160)
  email                 String        @db.VarChar(320)
  phone                 String?       @db.VarChar(40)
  subject               String?       @db.VarChar(200)
  message               String
  status                ContactStatus @default(new)
  assignedToAdminUserId String?       @map("assigned_to_admin_user_id") @db.Uuid
  resolvedAt            DateTime?     @map("resolved_at") @db.Timestamptz(6)
  sourcePath            String?       @map("source_path") @db.VarChar(500)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedTo            AdminUser?    @relation("ContactAssignedTo", fields: [assignedToAdminUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)], map: "contact_submissions_status_created_idx")
  @@map("contact_submissions")
}

model NotificationDelivery {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId       String?             @map("registration_id") @db.Uuid
  participantProfileId String?             @map("participant_profile_id") @db.Uuid
  channel              String              @db.VarChar(30)
  templateKey          String              @map("template_key") @db.VarChar(100)
  recipient            String              @db.VarChar(320)
  payload              Json                @default("{}") @db.JsonB
  status               NotificationStatus  @default(queued)
  providerMessageId    String?             @map("provider_message_id") @db.VarChar(255)
  attempts             Int                 @default(0)
  lastAttemptAt        DateTime?           @map("last_attempt_at") @db.Timestamptz(6)
  sentAt               DateTime?           @map("sent_at") @db.Timestamptz(6)
  failedAt             DateTime?           @map("failed_at") @db.Timestamptz(6)
  failureReason        String?             @map("failure_reason")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  registration         Registration?       @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  participantProfile   ParticipantProfile? @relation(fields: [participantProfileId], references: [id], onDelete: SetNull)

  @@index([status, createdAt], map: "notification_deliveries_status_created_idx")
  @@map("notification_deliveries")
}

model ParticipantConsent {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantProfileId String               @map("participant_profile_id") @db.Uuid
  consentType          String               @map("consent_type") @db.VarChar(100)
  policyVersion        String               @map("policy_version") @db.VarChar(80)
  granted              Boolean
  capturedAt           DateTime             @default(now()) @map("captured_at") @db.Timestamptz(6)
  ipAddress            Unsupported("inet")? @map("ip_address")
  source               String?              @db.VarChar(80)
  participantProfile   ParticipantProfile   @relation(fields: [participantProfileId], references: [id], onDelete: Restrict)

  @@unique([participantProfileId, consentType, policyVersion], map: "participant_consents_version_unique")
  @@index([participantProfileId, consentType], map: "participant_consents_profile_idx")
  @@map("participant_consents")
}
